{
  "name": "@m9c/number-to-words-converter-mkd",
  "version": "0.0.4",
  "description": "Number to words converter in macedonian language",
  "license": "MIT",
  "author": "Sasho Mihajlov",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.15.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihajlovco/number-to-words-converter-mkd.git"
  },
  "bugs": {
    "url": "https://github.com/mihajlovco/number-to-words-converter-mkd/issues"
  },
  "homepage": "https://github.com/mihajlovco/number-to-words-converter-mkd#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "lint": "eslint . --ignore-path .eslintignore --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "ci": "pnpm run lint && pnpm run test && pnpm run build",
    "release": "pnpm run ci && changeset publish",
    "prepare": "husky",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "number",
    "words",
    "macedonian",
    "mkd",
    "converter"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@changesets/types": "^6.0.0",
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.8.0",
    "husky": "^9.1.5",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.16.1"
  }
}
